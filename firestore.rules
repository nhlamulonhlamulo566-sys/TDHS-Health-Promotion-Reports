rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Administrator';
    }

    function isAdministrator() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator';
    }

    function userDistrict() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.district;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isActivityOwner(activity) {
        return request.auth.uid == activity.userId;
    }

    // ----------------------------
    // 👤 USERS COLLECTION
    // ----------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdministrator() || isSuperAdmin();
      allow list: if isAdministrator() || isSuperAdmin();
      // Allow user creation via client, but only with specific, validated fields
      allow create: if request.auth != null &&
                      request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'district', 'persalNumber', 'organization', 'phone']) &&
                      request.resource.data.uid == request.auth.uid;
      allow update: if (isOwner(userId) || isAdministrator() || isSuperAdmin()) &&
                       request.resource.data.keys().hasOnly(['displayName', 'phone', 'persalNumber', 'district', 'organization', 'role']);
      allow delete: if isAdministrator() || isSuperAdmin();
    }

    // ----------------------------
    // 📋 ACTIVITIES COLLECTION
    // ----------------------------
    match /activities/{activityId} {
      // READ/LIST: Super Admins see all. Admins see their district. Users see their own.
      allow read, list: if isSuperAdmin() || 
                        (isAdministrator() && resource.data.district == userDistrict()) ||
                        (request.auth != null && resource.data.userId == request.auth.uid);
      
      // CREATE: Logged-in users can create activities for themselves with validated data structures.
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid &&
                       isValidActivity(request.resource.data);
      
      // UPDATE: Owners, Admins, and Super Admins can update.
      allow update: if isSuperAdmin() ||
                      (isAdministrator() && resource.data.district == userDistrict()) ||
                      isActivityOwner(resource.data);
                      
      // DELETE: Owners, Admins, and Super Admins can delete.
      allow delete: if isSuperAdmin() ||
                      (isAdministrator() && resource.data.district == userDistrict()) ||
                      isActivityOwner(resource.data);
    }
    
    // --- Data Validation Functions ---
    function isValidActivity(data) {
      return data.type == 'Weekly Plan' ? isValidWeeklyPlan(data)
           : data.type == 'Health Talk' ? isValidHealthTalk(data)
           : data.type == 'School Visit' ? isValidSchoolVisit(data)
           : data.type == 'Creche Visit' ? isValidCrecheVisit(data)
           : data.type == 'Health Campaign' ? isValidHealthCampaign(data)
           : data.type == 'Social Mobilization' ? isValidSocialMobilization(data)
           : data.type == 'IMCI Training' ? isValidImciTraining(data)
           : data.type == 'Outbreak Response' ? isValidOutbreakResponse(data)
           : data.type == 'Support Group' ? isValidSupportGroup(data)
           : data.type == 'Corner to Corner' ? isValidCornerToCorner(data)
           : data.type == 'TISH' ? isValidTish(data)
           : data.type == 'Document Upload' ? isValidDocumentUpload(data)
           : data.type == 'Health Special Project' ? isValidHealthSpecialProject(data)
           : false;
    }

    function hasBaseActivityFields(data) {
        return data.keys().hasAll(['date', 'type', 'details', 'userId', 'district', 'createdAt']);
    }

    function isValidWeeklyPlan(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['activity', 'venue', 'nb', 'startTime', 'endTime', 'date']);
    }

    function isValidHealthTalk(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['venue', 'topics', 'startTime', 'endTime', 'peopleReached', 'date']) &&
               (data.details.topics.hasAny(['other']) == false || data.details.keys().hasAll(['otherTopic']));
    }

    function isValidSchoolVisit(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['schoolName', 'gradeLevel', 'topic', 'studentsReached', 'startTime', 'endTime', 'date']) &&
               (data.details.topic.hasAny(['Other']) == false || data.details.keys().hasAll(['otherTopic']));
    }
    
    function isValidCrecheVisit(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['crecheName', 'ageGroup', 'topic', 'childrenMindersReached', 'parentsReached', 'childrenReached', 'startTime', 'endTime', 'date']) &&
               (data.details.topic.hasAny(['Other']) == false || data.details.keys().hasAll(['otherTopic']));
    }

    function isValidHealthCampaign(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['campaignType', 'targetGroup', 'venue', 'location', 'peopleReached', 'startTime', 'endTime', 'date']) &&
               (data.details.campaignType != 'Other' || data.details.keys().hasAll(['otherCampaignType'])) &&
               (data.details.targetGroup != 'Other' || data.details.keys().hasAll(['otherTargetGroup']));
    }
    
    function isValidSocialMobilization(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['location', 'campaignType', 'mobilizationMethod', 'topic', 'peopleReached', 'startTime', 'endTime', 'date']) &&
               (data.details.campaignType.hasAny(['Other']) == false || data.details.keys().hasAll(['otherCampaignType'])) &&
               (data.details.mobilizationMethod.hasAny(['Other']) == false || data.details.keys().hasAll(['otherMobilizationMethod'])) &&
               (data.details.topic != 'Other' || data.details.keys().hasAll(['otherTopic']));
    }

    function isValidImciTraining(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['venue', 'peopleReached', 'traineeType', 'startTime', 'endTime', 'date']) &&
               (data.details.traineeType != 'Other' || data.details.keys().hasAll(['otherTraineeType']));
    }

    function isValidOutbreakResponse(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['location', 'diseaseType', 'severityLevel', 'topic', 'peopleReached', 'startTime', 'endTime', 'date']) &&
               (data.details.diseaseType != 'Other' || data.details.keys().hasAll(['otherDiseaseType'])) &&
               (data.details.topic != 'Other' || data.details.keys().hasAll(['otherTopic']));
    }

    function isValidSupportGroup(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['venue', 'supportGroupType', 'topic', 'physicalActivity', 'peopleReached', 'startTime', 'endTime', 'date']) &&
               (data.details.supportGroupType != 'Other' || data.details.keys().hasAll(['otherSupportGroupType'])) &&
               (data.details.topic != 'Other' || data.details.keys().hasAll(['otherTopic'])) &&
               (data.details.physicalActivity != 'Other' || data.details.keys().hasAll(['otherPhysicalActivity']));
    }
    
    function isValidCornerToCorner(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['venue', 'services', 'startTime', 'endTime', 'peopleReached', 'date']) &&
               (data.details.services.all(s => s.keys().hasAll(['id', 'label', 'peopleReached']))) &&
               (!data.details.services.exists(s, s.id == 'other') || data.details.keys().hasAll(['otherTopic']));
    }

    function isValidTish(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['venue', 'services', 'startTime', 'endTime', 'peopleReached', 'date']) &&
               (data.details.services.all(s => s.keys().hasAll(['id', 'label', 'peopleReached']))) &&
               (!data.details.services.exists(s, s.id == 'other') || data.details.keys().hasAll(['otherTopic']));
    }
    
    function isValidDocumentUpload(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['title', 'registerAttachment', 'pictureAttachment', 'notes']);
    }

    function isValidHealthSpecialProject(data) {
        return hasBaseActivityFields(data) &&
               data.details.keys().hasAll(['projectName', 'location', 'description', 'peopleReached', 'startTime', 'endTime', 'date']);
    }
  }
}
